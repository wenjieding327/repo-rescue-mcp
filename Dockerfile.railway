FROM node:20-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY http-sse-server.mjs platform-entry.mjs stdio-server.mjs ./
COPY actions-bridge.mjs snippet-pair.mjs snippet-worker-env.mjs snippet-worker.mjs ./

USER node
EXPOSE 3000

CMD ["node", "http-sse-server.mjs"]
