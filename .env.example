# Required only for the server-managed Repair Agent path. The prepare/verify
# host-agent path uses the surrounding platform model and needs no separate key.
OPENAI_API_KEY=
REPO_RESCUE_OPENAI_MODEL=gpt-5.6-terra

# Comma-separated owner/repository slugs that may execute.
REPO_RESCUE_ALLOWED_REPOS=wenjieding327/repo-rescue-canary,wenjieding327/repo-rescue-mcp
# Leave empty unless an administrator has reviewed a repair that genuinely
# needs a new distribution name not already declared by the repository.
REPO_RESCUE_ALLOWED_ADDITIONAL_DEPENDENCIES=

# Generic stdio launcher / local live-smoke configuration only. Do not copy
# these values into the XFYun hosting form and never store a real token in an
# .env file. The competition `repo-rescue-mcp-platform` bin overrides every
# non-secret value below; XFYun declares only REPO_RESCUE_GITHUB_TOKEN without
# a default and injects it when the private MCP is linked to the team APPID.
# For generic self-hosting, use a fine-grained token limited to the control
# repository with Actions read/write and keep the allow-list identical to the
# fixed workflow list.
REPO_RESCUE_NODE_TOOLSET=platform
REPO_RESCUE_GITHUB_TOKEN=
REPO_RESCUE_ACTIONS_REPOSITORY=wenjieding327/repo-rescue-mcp
REPO_RESCUE_ACTIONS_WORKFLOW=repo-rescue-actions-bridge.yml
REPO_RESCUE_ACTIONS_REF=main
REPO_RESCUE_ACTIONS_MAX_ACTIVE=1
REPO_RESCUE_ACTIONS_STARTS_PER_MINUTE=3
REPO_RESCUE_ACTIONS_STARTS_PER_HOUR=12
REPO_RESCUE_ACTIONS_MIN_POLL_MS=2000
REPO_RESCUE_ACTIONS_RESULT_TTL_MS=900000
REPO_RESCUE_ACTIONS_DISPATCH_DISCOVERY_MS=120000
REPO_RESCUE_ACTIONS_MAX_RUN_MS=1320000
REPO_RESCUE_ACTIONS_REQUEST_TIMEOUT_MS=15000
REPO_RESCUE_ACTIONS_ARTIFACT_TIMEOUT_MS=30000
REPO_RESCUE_SNIPPET_WORKER_TIMEOUT_MS=6000

# MCP server settings.
REPO_RESCUE_HOST=0.0.0.0
REPO_RESCUE_PORT=8000
REPO_RESCUE_TRANSPORT=streamable-http

# Short-call agent-platform queue. This process-local store requires exactly
# one application process/replica; production scale-out needs Redis/database.
REPO_RESCUE_JOB_MAX_JOBS=16
REPO_RESCUE_JOB_MAX_RESULTS=64
REPO_RESCUE_JOB_TTL_SECONDS=900
REPO_RESCUE_JOB_MAX_LONG_POLLS=8

# Docker is the local default for untrusted GitHub repository repair. Direct
# mode is only for a service already inside a disposable resource-limited host.
REPO_RESCUE_EXECUTION_BACKEND=docker
REPO_RESCUE_PYTHON_IMAGE=repo-rescue-python:3.11
REPO_RESCUE_MAX_REPO_MB=50

# Durable patch and evidence output.
REPO_RESCUE_ARTIFACTS_DIR=artifacts
REPO_RESCUE_INSTALL_TIMEOUT_SECONDS=180
REPO_RESCUE_RUN_TIMEOUT_SECONDS=60
