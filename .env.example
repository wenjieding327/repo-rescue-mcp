# Required only for real GitHub repository repair.
OPENAI_API_KEY=
REPO_RESCUE_OPENAI_MODEL=gpt-5.6-terra

# Comma-separated owner/repository slugs that may execute.
REPO_RESCUE_ALLOWED_REPOS=owner/repository

# MCP server settings.
REPO_RESCUE_HOST=0.0.0.0
REPO_RESCUE_PORT=8000
REPO_RESCUE_TRANSPORT=streamable-http

# Docker is required for untrusted GitHub repository repair.
REPO_RESCUE_EXECUTION_BACKEND=docker
REPO_RESCUE_PYTHON_IMAGE=repo-rescue-python:3.11
REPO_RESCUE_MAX_REPO_MB=50

# Durable patch and evidence output.
REPO_RESCUE_ARTIFACTS_DIR=artifacts
REPO_RESCUE_INSTALL_TIMEOUT_SECONDS=180
REPO_RESCUE_RUN_TIMEOUT_SECONDS=60
